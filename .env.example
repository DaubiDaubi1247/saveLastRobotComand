# Настройки сервера
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Настройки InfluxDB
INFLUX_HOST=192.168.22.11
INFLUX_PORT=8086
INFLUX_USERNAME=user
INFLUX_PASSWORD=pass
INFLUX_DATABASE=influx

# Настройки Telegraf
TELEGRAF_HOST=192.168.22.11
TELEGRAF_PORT=8092

# Интервал опроса роботов (секунды)
POLL_INTERVAL=15

# Ключ аутентификации для роботов
ROBOT_AUTH_KEY=My_example_KEY

# Логирование
LOG_LEVEL=INFO
LOG_FILE=robot_server.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Конфигурация роботов: ROBOT_<NAME>=<IP>:<PORT>:<TIMEOUT>:<TAG>
ROBOT_W8R1=10.1.0.82:3333:2000:W8R1
ROBOT_W8R2=10.1.0.84:3333:2000:W8R2
ROBOT_W8R3=10.1.0.86:3333:2000:W8R3
ROBOT_W8R4=10.1.0.88:3333:2000:W8R4
ROBOT_W1R1=10.1.0.14:3333:2000:W1R1
ROBOT_W1R2=10.1.0.16:3333:2000:W1R2
ROBOT_W2R1=10.1.0.44:3333:2000:W2R1
ROBOT_W2R2=10.1.0.46:3333:2000:W2R2
ROBOT_W1x4R1=10.1.0.32:4444:2000:W1x4R1
ROBOT_W1x4R2=10.1.0.34:3333:2000:W1x4R2
ROBOT_W1x4R3=10.1.0.36:4444:2000:W1x4R3
ROBOT_W1x4R4=10.1.0.38:3333:2000:W1x4R4
ROBOT_W8R5=10.1.0.117:3333:2000:W8R5
ROBOT_W7R1=10.1.0.71:3333:2000:W7R1
ROBOT_W1R7=10.1.0.18:3333:2000:W1R7
